# local copy of the project archive made by tools/sync_archive.py; build.py reads it, never published
archive/
# written by tools/build.py next to data/; lists archive paths, not for publishing
build_report.txt
# written by tools/build.py: each sieve results.json read and checked once (delete it to check them all again)
.build_cache/
__pycache__/
*.pyc
# Worker tooling
worker/node_modules/
worker/.wrangler/
# never commit the upload admin token
upload_admin_token.txt
.dev.vars
# written by tools/auto_update.py on the PC that runs the scheduled task
auto_update.log
auto_update.log.1
auto_update.lock
auto_update_state.json
auto_update_state.json.tmp
# written by tools/live_prp.py: the progress of the Prime95 PRP run on this PC, read once an hour
live/
